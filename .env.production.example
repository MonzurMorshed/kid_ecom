# ==============================================================================
# KiduraBD - Production Environment Configuration for Namecheap cPanel
# Copy this file to .env on your server and update the values
# ==============================================================================

# Set to False in production
DEBUG=False

# Generate a strong secret key (e.g., using: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())')
SECRET_KEY=your-production-secret-key-here

# Comma-separated list of allowed domains
# Example: yourdomain.com,www.yourdomain.com
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# Comma-separated list of trusted HTTPS origins (Required for Django 4+ CSRF over SSL)
# Example: https://yourdomain.com,https://www.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ── Database (Namecheap cPanel MySQL) ─────────────────────────────────────────
# In cPanel, database and usernames are prefixed with your cPanel username (e.g. cpuser_dbname)
DB_NAME=cpaneluser_kidecom
DB_USER=cpaneluser_dbuser
DB_PASSWORD=your_strong_db_password
DB_HOST=localhost
DB_PORT=3306

# ── Site Identity ─────────────────────────────────────────────────────────────
SITE_NAME=Kidurabd
SITE_URL=https://yourdomain.com

# ── Email Settings (Namecheap Webmail / Private Email / Gmail) ────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mail.yourdomain.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_HOST_USER=noreply@yourdomain.com
EMAIL_HOST_PASSWORD=your_email_password
DEFAULT_FROM_EMAIL=Kidurabd <noreply@yourdomain.com>
ADMIN_NOTIFICATION_EMAIL=admin@yourdomain.com
